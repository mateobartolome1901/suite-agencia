# Copiar a .env (no se sube al repo) para correr en local, o cargar en Render > Environment.
SECRET_KEY=cambiar-por-un-texto-largo-al-azar
DEV_LOGIN=1                      # solo local: login sin Google
ADMINS=tu-email@gmail.com,email-de-luis@gmail.com
DOMINIO_ADMIN=
DATABASE_URL=sqlite:///suite-local.db
ZONA_HORARIA=America/New_York

# Login con Google (Google Cloud Console > Credenciales > ID de cliente OAuth, tipo Aplicación web)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GHL: por cada subcuenta, su ID y su token de Private Integrations (una línea cada uno; el nombre del medio es libre)
GHL_PLASTIA_ID=
GHL_PLASTIA_TOKEN=
GHL_REALTOR_MILLONARIO_ID=
GHL_REALTOR_MILLONARIO_TOKEN=

# Meta: token de un usuario del sistema del Business Manager con ads_read y read_insights
META_ACCESS_TOKEN=

# YouTube (Google Ads API)
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=

# Sin META_ACCESS_TOKEN el worker publica datos de ejemplo. Para forzar: DATOS_DEMO=1 / 0
